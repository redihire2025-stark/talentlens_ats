# TalentLens — V1 is anonymous and requires no external services by default.
# Copy this file to .env and adjust only if you enable an optional feature below.

VITE_APP_NAME=TalentLens

# --- Optional, future ---
# The ATS and matching engines are deterministic and never require an LLM.
# This is a placeholder for an *optional* AIProvider/SemanticMatcher
# implementation (see docs/architecture/overview.md) and is unused in V1
# unless set.
#
# VITE_OPENAI_API_KEY= # auto AI-drafted bullet rewrite
#   (src/lib/ai/openaiClient.ts, platform.openai.com key)
#   Local dev only: VITE_-prefixed vars ship inside the client bundle, so
#   don't set this in a deployed build without a backend proxy first.
